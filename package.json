{
  "name": "minimal-editor",
  "version": "0.1.0",
  "description": "A minimal, fast, VS Code-familiar editor for quickly reviewing code changes. No extensions, no telemetry, no agent upsell.",
  "type": "module",
  "main": "electron/main.cjs",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "dev": "vite build && electron .",
    "smoke": "node scripts/smoke.mjs",
    "ban-gate": "bash scripts/ban-gate.sh",
    "test": "npm run ban-gate && node --test test/*.test.mjs"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "40.6.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
