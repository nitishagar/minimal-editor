{
  "name": "minimal-editor",
  "version": "0.1.0",
  "description": "A minimal, fast, VS Code-familiar editor for quickly reviewing code changes. No extensions, no telemetry, no agent upsell.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build:web": "vite build",
    "dev:web": "vite --port 1420 --strictPort",
    "dev": ". ./scripts/env.sh && tauri dev",
    "build": ". ./scripts/env.sh && tauri build",
    "e2e": ". ./scripts/env.sh && tauri dev -- -- --e2e",
    "test:rs": ". ./scripts/env.sh && cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "ban-gate": "bash scripts/ban-gate.sh",
    "test": "npm run ban-gate && npm run typecheck && npm run test:rs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
